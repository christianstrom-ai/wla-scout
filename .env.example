# ==== YouTube ====
YOUTUBE_API_KEY=
# OAuth (klistras in från Google Cloud Console — använder ytbedomare-projektet)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Path till sparad OAuth-token (refresh_token-flow). Genereras av:
#   python -m src.cli oauth-init
GOOGLE_OAUTH_TOKEN_PATH=.secrets/google_token.json

# WLA-kanalens YouTube channel-id (UCxxxx…). Används av Analytics API.
WLA_CHANNEL_ID=

# ==== Anthropic (LLM) ====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_BROAD=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ESCALATE=claude-sonnet-4-6

# ==== Sheets ====
# WLA Publicerade-sheet, från specen
WLA_PUBLISHED_SHEET_ID=1taCKPB-H5K5fXRbQDrghDlwptzZ_BQglCbn6XM8KqbQ
WLA_PUBLISHED_SHEET_TAB=Sheet1

# ==== Trösklar (från specen §9) ====
DAILY_LLM_BUDGET_USD=3.30
MAX_SUBSCRIBERS=50000
CANDIDATE_POOL_SIZE=200
LLM_TOPN=40
QUALITY_FLOOR=55
LOW_YIELD_ALERT_DAYS=3
MIN_FEEDBACK_DATAPOINTS=20
MATURITY_POLL_HOURS=6,24,48
DEDUP_WINDOW_DAYS=30
RETENTION_DAYS_REJECTED=90
RETENTION_DAYS_UNPUBLISHED_YES=90

# ==== Tid / schemaläggning ====
TZ=Europe/Stockholm
SCHEDULE_CRON_SCOUT=0 6 * * *
SCHEDULE_CRON_MATURITY=0 */6 * * *
SCHEDULE_CRON_SHEET_SYNC=0 2 * * *

# ==== Auth ====
# Delad inloggning v1. Sätt ett långt slumpat värde.
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_AUTH_SECRET=  # för JWT-signering av session-cookies

# ==== Alerts ====
ALERT_WEBHOOK=

# ==== DB ====
DATABASE_URL=sqlite:///./wla.db
# Prod-exempel: postgresql+psycopg://user:pass@host:5432/wla

# ==== Scoring-vikter (JSON) ====
# Två profiler — Shorts viktas annorlunda än long-form
WEIGHTS_SHORTS_JSON={"velocity":0.30,"engagement":0.20,"overperformance":0.15,"profile_match":0.10,"story":0.10,"reachability":0.10,"originality":0.05}
WEIGHTS_LONGFORM_JSON={"velocity":0.10,"engagement":0.15,"overperformance":0.10,"profile_match":0.25,"story":0.25,"reachability":0.10,"originality":0.05}
